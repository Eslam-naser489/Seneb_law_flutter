  "fixed_sql": [
    {
      "name": "office_lawyers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"office_lawyers\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "clients",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"clients\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"phone\" TEXT NULL, \"assigned_lawyer_id\" TEXT NULL REFERENCES office_lawyers (id), \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "cases",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cases\" (\"id\" TEXT NOT NULL, \"client_id\" TEXT NOT NULL REFERENCES clients (id), \"case_number\" TEXT NOT NULL, \"opponent_name\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'جارية', \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" TEXT NOT NULL, \"case_id\" TEXT NOT NULL REFERENCES cases (id), \"session_date\" INTEGER NOT NULL, \"court_location\" TEXT NOT NULL, \"circle_number\" TEXT NULL, \"decision\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "case_notes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"case_notes\" (\"id\" TEXT NOT NULL, \"case_id\" TEXT NOT NULL REFERENCES cases (id), \"content\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"amount\" REAL NOT NULL, \"type\" TEXT NOT NULL, \"transaction_date\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"case_id\" TEXT NULL REFERENCES cases (id), \"client_id\" TEXT NULL REFERENCES clients (id), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "case_documents",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"case_documents\" (\"id\" TEXT NOT NULL, \"case_id\" TEXT NOT NULL REFERENCES cases (id), \"title\" TEXT NOT NULL, \"file_path\" TEXT NOT NULL, \"file_type\" TEXT NOT NULL, \"uploaded_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
